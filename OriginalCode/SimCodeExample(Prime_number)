Tree():
    Act():
        mov @CTR_LoopThis , 1;                    ループコントロール
        mov @CTR_Spectate , 0;
    Act():
        mov #CPU_a , @Result[0];                   Resultを代入
    Act():
        mov @N{0} , #CPU_b;                        Nをロード
    Tree():
        Act():
            mov ^Result{0} , @Text[0];           結果に文字列を代入
        Act():
            mov @n{0} , 2;                                  n = 2 初期値
        Act():
            mov @Ncopy{0} , ^N[0];
        Tree():
            Act():
                div @Remain{0} , ^Ncopy[0] , ^n[0];       余りを算出
            Act():
                bne @Mod_0{0} , @Remain[0] , 0;       余りが0なら 0, 0でないなら 1
            Act():
                sub @n_minus_1{0} , ^n[0] , 1;           
            Act():
                bne @N_n+1{0} , ^Ncopy[0] , @n_minus_1[0];           N = n+1 なら 0 , そうでないなら1
            Act():
                not %CTR_Skip , @Mod_0[0];                        余りが0のときSKIP
                mov @SkipB , @N_n+1[0];                           SkipB :  実行時0, SKIP時 1
                Act():
            Act():
                mov %CTR_Skip , @Mod_0[0];                        余りが0なら 実行, そうでないならSKIP
                mov ^Text{0} , "False";
            Act():
                mov %CTR_Skip , @SkipB[0];                        余りが0でないかつN = n+1 のとき 実行
                add ^n{1} ,1;                                    n += 1
            Act():
                mov @CTR_Spectate , ;
            Act():
                mov @CTR_LoopThis ,;

