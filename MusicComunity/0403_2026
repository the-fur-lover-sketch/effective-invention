import sounddevice as sd
import numpy as np
from flask import Flask, request
from scipy import signal
#from flask_socketio import SocketIO 
import threading

# -----------------------------
# 音声デバイス設定
# -----------------------------
output_device = 3
sd.default.device = output_device
fs = int(sd.query_devices(output_device)['default_samplerate'])
print("Using fs:", fs)

# -----------------------------
# 周波数管理
# -----------------------------
frequency = 440 
target_frequency = 440
freq_lock = threading.Lock()  #周波数を保護するロック

# -----------------------------
# 音声コールバック
# -----------------------------
def audio_callback(outdata, frames, time, status):
    global frequency
    t = (np.arange(frames) + audio_callback.pos) / fs #時間軸を作成
    with freq_lock:
        # 周波数を少しずつ変化させて滑らかに
        diff = target_frequency - frequency
        step = diff / frames
        freqs = frequency + step * np.arange(frames)
        frequency += diff # 最終的にtarget_frequencyに近づける
    

    mod_freq = 100
    phaseSub = 2 * np.pi *freqs * t + 2* np.pi* 2 * np.sin(2*np.pi* mod_freq*t)/4/mod_freq  #周波数に変化を加える
    phaseSub *= 1
    phaseMain = 2 * np.pi *freqs * t
    outdata[:, 0] = 0.5 * signal.sawtooth(phaseMain) + 0.5 * signal.sawtooth(phaseSub)  #メインの周波数と変化を加えた周波数の合成7
    audio_callback.pos += frames

audio_callback.pos = 0  #サンプル位置を追跡するための属性

stream = sd.OutputStream(channels=1, samplerate=fs, callback=audio_callback)
stream.start()

#iphoneから数値を操作
app = Flask(__name__)

@app.route("/")
def index():
    return """
    <h3>Frequency Controller</h3>
    <input type="range" id="freq" min="100" max="2000" value="440" oninput="send(this.value)">
    <span id="val">440</span> Hz

    <script>
    function send(v){
        document.getElementById("val").innerText = v;
        fetch("/set?f=" + v);
    }
    </script>
    """

@app.route("/set")
def set_value():
    global frequency
    f = float(request.args.get("f"))
    with freq_lock: #周波数を更新する前にロックを取得: lockされていたら周波数を更新できない
        frequency = f 
    print("frequency:", frequency)
    return "OK"

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
